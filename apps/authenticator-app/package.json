    "@autional/ui": "0.1.0-rc.42",
    "@tanstack/react-query": "5.100.9",
    "html5-qrcode": "2.3.8",
    "i18next": "26.0.10",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "0.509.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.7",
    "react-router": "7.15.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@autional/tsconfig": "0.1.0-rc",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.0",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.19",
