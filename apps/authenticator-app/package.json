{
  "name": "@autional/authenticator-app",
  "version": "0.1.0",
  "private": true,
  "description": "Autional Authenticator — Web PWA TOTP & Push MFA verifier",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/gen-env.mjs && vite --port 13108",
    "build": "node ../../scripts/gen-env.mjs && tsc && vite build",
    "prebuild": "node ../../scripts/check-pwa-config.mjs",
    "build:harness": "vite build --config vite.harness.config.ts",
    "preview": "vite preview --port 13108",
    "lint": "eslint src/",
    "lint:a11y": "eslint -c eslint.a11y.config.mjs --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "lint:focus": "node scripts/check-focus-visible.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@autional/shared": "0.1.0-rc.67",
    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.18",
    "@autional/ui": "0.1.0-rc.56",
    "@tanstack/react-query": "5.100.9",
    "html5-qrcode": "2.3.8",
    "i18next": "26.0.10",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "0.509.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.7",
    "react-router": "7.15.0",
    "workbox-core": "7.4.1",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@autional/eslint-config": "0.1.0-rc.1",
    "@autional/tsconfig": "0.1.0-rc",
    "@testing-library/jest-dom": "6.9.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
