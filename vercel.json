{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @autional-cn/authenticator-app... build",
  "outputDirectory": "apps/authenticator-app/dist",
  "rewrites": [
    {
      "source": "/bff/:path*",
      "destination": "https://api.autional.com/bff/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.autional.com/api/v1/:path*"
    },
    {
      "source": "/oauth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://api.autional.com/oauth/:path*"
    },
    {
      "source": "/tenant/:path*",
      "destination": "https://api.autional.com/tenant/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
